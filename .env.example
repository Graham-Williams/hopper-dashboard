# Copy to .env on the box (chmod 600). Never commit .env.
# The four secrets below are REQUIRED: compose refuses to start (`${VAR:?}`) and the read role
# refuses to boot in APP_ENV=prod without APP_PASSWORD, or with APP_PASSWORD but no SESSION_SECRET.
APP_PASSWORD=change-me              # password gate for the HTML/JSON read side. THIS APP HAS ITS
                                    # OWN password — deliberately NOT the shared house word used by
                                    # km-tracker / taste-twin / jjho / todoist-points. The board is
                                    # linked from the public apex page and now stores recordings of
                                    # Graham's voice; a word handed to friends is the wrong gate for
                                    # that. Set it by hand on the box (DEPLOY.md §1c); never echo it
                                    # into a command, a script argument or a log.
SESSION_SECRET=change-me            # random 32+ chars; signs the session cookie (openssl rand -hex 32)
INGEST_TOKEN=change-me              # bearer token jobs use to POST heartbeats (Tailscale-only port)
READ_TOKEN=change-me                # bearer token Hopper uses to GET /api/v1/status without a cookie
NTFY_URL=https://ntfy.sh            # empty disables alerts
NTFY_TOPIC=                         # long random topic name; treat as a secret
APP_HOST=dashboard.graham-williams.com
                                    # Host/Origin pin AND the authority of the http->https 307.
                                    # MUST be a BARE hostname: no scheme, port, path, "@" or
                                    # whitespace. Anything else disables the redirect (logged at
                                    # start-up) rather than emitting an unsafe Location.
APP_ENV=prod
TRUSTED_PROXY_CIDR=                 # CIDR(s), comma-separated, whose CF-Connecting-IP header the READ role
                                    # trusts for login rate-limiting — set to the km-tracker_default subnet
                                    # (docker network inspect km-tracker_default -f '{{range .IPAM.Config}}{{.Subnet}}{{end}}').
                                    # Empty = never trust the header (remote_addr only).

# --- container / deploy knobs (compose reads these; all have safe defaults) ---
INGEST_BIND=127.0.0.1               # host IP the ingest port (8081) is published on. Set to the box's
                                    # Tailscale IP (<box-tailscale-ip>) so the Mac can post heartbeats.
                                    # NEVER 0.0.0.0 (ufw is inactive on the box → LAN-exposed).
PROBE_INTERVAL_S=300                # how often the in-container rclone destination probes run. This is the
                                    # floor; a job may probe less often via probe.interval_s in jobs.yml.
DASHBOARD_RCLONE_TIMEOUT_S=240      # hard timeout for ONE `rclone lsjson`. NOT named RCLONE_TIMEOUT_S: that is
                                    # rclone's own env namespace (`--timeout`). Probes are SERIAL, so the real
                                    # invariant is n_probed_per_cycle * timeout < PROBE_INTERVAL_S — the app
                                    # also clamps the timeout to PROBE_INTERVAL_S and caps a whole cycle's
                                    # wall clock at one PROBE_INTERVAL_S, deferring the rest to the next cycle.
PROBE_FAIL_THRESHOLD=2              # consecutive failed probes OF ONE JOB before `dashboard-probes` reports
                                    # FAIL (1–10). 1 = alert on the first transient Drive rate limit — the
                                    # flapping behaviour this replaced (27 FAIL→OK flips / ~55 pushes in 4
                                    # days with nothing broken). Only transient quota/timeout errors are
                                    # damped at all; a hard error (missing dir, revoked token) trips on the
                                    # first failure. Recovery is always immediate — one successful probe.
PROBE_NO_SUCCESS_S=3600             # backstop: FAIL any probed job with no SUCCESSFUL probe for this long,
                                    # whatever the threshold says. Damping may delay an alert, never cancel
                                    # one. 0 disables (not recommended).
JOBS_FILE=/app/jobs.yml             # job registry inside the container (compose bind-mounts ./jobs.yml here)
RCLONE_CONF=~/.config/rclone/dashboard-ro.conf    # host rclone config for the probes: a drive.readonly-scope
                                                  # remote (DEPLOY.md §1b). Mounted :ro, copied to tmpfs at start.
                                                  # Fallback (documented risk): ~/.config/rclone/rclone.conf
KM_STATE=~/km-backups/state                       # km-tracker backup state dir (last_drive.sha256 / .epoch), :ro
TODOIST_STATE=~/todoist-points/data/.backup-state # todoist-points backup state dir, :ro

# --- the Inbox (/inbox) ------------------------------------------------------
# All optional. With INBOX_TOKEN empty the browser side of /inbox still works and every
# MACHINE endpoint fails closed with 401 — the Mac worker and the backlog mirror simply
# cannot reach it. That is deliberate: the board booting matters more than the Inbox booting,
# which is why none of these is a `${VAR:?}` in docker-compose.yml.
INBOX_TOKEN=                        # bearer token for the MACHINE side only (the Mac transcription
                                    # worker + the backlog mirror). A THIRD credential, separate from
                                    # INGEST_TOKEN (Tailscale heartbeats) and READ_TOKEN (Hopper's
                                    # read-only status GETs) — scoped to a fixed list of Inbox
                                    # endpoints and usable for nothing else. openssl rand -hex 32.
                                    # Empty = the Inbox is browser-only. The same value goes in the
                                    # Mac's ~/.config/hopper-dashboard/env as INBOX_TOKEN.
INBOX_AUDIO_MAX_BYTES=2097152       # 2 MiB per voice note (~10 min of 30 kbps Opus) — far past any real
                                    # bug report. Applied PER REQUEST on the create route only; the
                                    # global 64 KB body cap that protects every other route is never
                                    # raised. Keep it well under the container's 64 MB tmpfs /tmp,
                                    # which multipart spools to. This cap MULTIPLIES by the create
                                    # limiter (30 per 15 min per IP) into how much disk one address
                                    # can spend, which is why it is not generous.
INBOX_AUDIO_MAX_TOTAL_BYTES=3221225472  # AGGREGATE ceiling on the whole audio tree, checked before each
                                    # upload; over it, uploads are refused with 507. The per-note cap
                                    # alone bounds nothing over TIME. 3 GB is years of real use (a 30 s
                                    # note is ~60 KB). box-disk only notices once the damage is done.
INBOX_AUDIO_RETENTION_DAYS=90       # audio is deleted when ALL THREE hold: the transcript is
                                    # Whisper-quality, the item has been reviewed, and it is older than
                                    # this. The text is in the DB backup long before then. 0 disables.
                                    # AND, unconditionally, at TWICE this age whatever its state — the
                                    # privacy ceiling. Without that second rule this setting reads like
                                    # a maximum and behaves like a minimum: a note never reviewed, or
                                    # one Whisper failed on, would keep its recording forever.
INBOX_GITHUB_REPOS=Graham-Williams/km-tracker,Graham-Williams/gremlins-minecraft-mods,Graham-Williams/hopper-dashboard,Graham-Williams/graham-williams.com,Graham-Williams/todoist-points,Graham-Williams/taste-twin,Graham-Williams/jjho-fan-almanac,Graham-Williams/bug-of-war,Graham-Williams/baby-pool,Graham-Williams/adhoc
                                    # `owner/repo`, comma- or whitespace-separated. App config, not
                                    # per-job data, so it lives here rather than in the gitignored
                                    # jobs.yml — a two-line .env append is a far safer box edit.
                                    # Validated at STARTUP: a malformed entry fails the container
                                    # immediately instead of at the first sync. These ten are the
                                    # PUBLIC repos; the five private ones are deliberately out,
                                    # because the mirror runs unauthenticated by default.
INBOX_GITHUB_TOKEN=                 # optional. Empty = unauthenticated (60 requests/hour, which is
                                    # ample at a 15-minute cadence over ten repos). A read-only,
                                    # public-repo-scoped PAT raises that to 5000/h and is the only
                                    # way to mirror the private repos. Treat as a secret.
INBOX_GITHUB_INTERVAL_S=900         # how often the in-container scheduler re-mirrors open issues.
                                    # ETag-conditional, and it honours X-RateLimit-Reset / Retry-After
                                    # into its own backoff, so this is a floor rather than a promise.
INBOX_PRUNE_INTERVAL_S=3600         # how often the audio prune + the orphan/dangling reconcile run.

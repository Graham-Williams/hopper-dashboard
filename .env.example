# Copy to .env on the box (chmod 600). Never commit .env.
# The four secrets below are REQUIRED: compose refuses to start (`${VAR:?}`) and the read role
# refuses to boot in APP_ENV=prod without APP_PASSWORD, or with APP_PASSWORD but no SESSION_SECRET.
APP_PASSWORD=change-me              # shared house password gate for the HTML/JSON read side
SESSION_SECRET=change-me            # random 32+ chars; signs the session cookie (openssl rand -hex 32)
INGEST_TOKEN=change-me              # bearer token jobs use to POST heartbeats (Tailscale-only port)
READ_TOKEN=change-me                # bearer token Hopper uses to GET /api/v1/status without a cookie
NTFY_URL=https://ntfy.sh            # empty disables alerts
NTFY_TOPIC=                         # long random topic name; treat as a secret
APP_HOST=dashboard.graham-williams.com
APP_ENV=prod
TRUSTED_PROXY_CIDR=                 # CIDR(s), comma-separated, whose CF-Connecting-IP header the READ role
                                    # trusts for login rate-limiting — set to the km-tracker_default subnet
                                    # (docker network inspect km-tracker_default -f '{{range .IPAM.Config}}{{.Subnet}}{{end}}').
                                    # Empty = never trust the header (remote_addr only).

# --- container / deploy knobs (compose reads these; all have safe defaults) ---
INGEST_BIND=127.0.0.1               # host IP the ingest port (8081) is published on. Set to the box's
                                    # Tailscale IP (<box-tailscale-ip>) so the Mac can post heartbeats.
                                    # NEVER 0.0.0.0 (ufw is inactive on the box → LAN-exposed).
PROBE_INTERVAL_S=300                # how often the in-container rclone destination probes run
JOBS_FILE=/app/jobs.yml             # job registry inside the container (compose bind-mounts ./jobs.yml here)
RCLONE_CONF=~/.config/rclone/dashboard-ro.conf    # host rclone config for the probes: a drive.readonly-scope
                                                  # remote (DEPLOY.md §1b). Mounted :ro, copied to tmpfs at start.
                                                  # Fallback (documented risk): ~/.config/rclone/rclone.conf
KM_STATE=~/km-backups/state                       # km-tracker backup state dir (last_drive.sha256 / .epoch), :ro
TODOIST_STATE=~/todoist-points/data/.backup-state # todoist-points backup state dir, :ro

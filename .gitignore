# secrets & deploy-local config — never commit
.env
.env.*
!.env.example
jobs.yml*
*.token
rclone*.conf
*-ro.conf
*.conf.bak
ingest.env

# runtime state
data/
*.db
*.db-wal
*.db-shm
*.sqlite*
*.log

# voice notes — belt and braces only. Everything the app actually writes lives
# under data/ (settings.inbox_audio_dir = <data>/inbox/audio) and is already
# covered by the line above; these catch a recording that ends up somewhere
# else — a scratch copy pulled off the box for debugging, a test fixture saved
# by hand. A recording of Graham's voice must never reach a public repo.
*.webm
*.m4a
*.ogg
*.wav

# python
__pycache__/
*.pyc
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
build/
dist/

# os / editor
.DS_Store
.idea/
.vscode/

# local scratch
.scratch/

# agent scratch (feature context, not part of the app)
.claude/

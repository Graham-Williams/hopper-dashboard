# hopper-dashboard: host-side container heartbeat (box-containers) + disk gauge (box-disk).
# TEMPLATE — deploy/box/install.sh replaces @@REPO@@ with the checkout path (~/hopper-dashboard)
# and @@USER@@ with the login that runs it (default: whoever invoked sudo; must be in `docker`).
#
# The dashboard container deliberately has NO docker socket; this oneshot, driven by
# dashboard-containers.timer every 5 min, is the only thing that reads `docker ps`. It also posts
# the box's root-filesystem capacity (box-disk) — a disk gauge has no schedule of its own, so it
# rides this timer rather than adding a second one. Runs as an unprivileged user in the docker
# group. Token + URL come from /etc/hopper-dashboard/ingest.env, read by systemd as root and
# handed to the process as environment.
[Unit]
Description=hopper-dashboard box probes (statvfs → box-disk, docker ps → box-containers)
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
User=@@USER@@
EnvironmentFile=-/etc/hopper-dashboard/ingest.env
ExecStart=@@REPO@@/deploy/box/containers_probe.sh
# Two probes run in sequence here, so the ceiling has to cover both worst cases:
#   disk probe:       statvfs (instant) + send_ping 3 attempts × 10 s + ~4.5 s backoff  ≈  35 s
#   containers probe: docker ps 30 s timeout + send_ping 3 × 10 s + ~4.5 s backoff      ≈  65 s
# ≈ 100 s, plus headroom for a slow interpreter start and a retrying curl in the wrapper's
# fallback ping. The old 60 s could not even cover the containers probe alone: systemd SIGTERMed
# the unit exactly when docker or the network was in trouble — i.e. when the disk reading matters
# most — and (before the disk probe was moved first) that reading was the one silently lost.
TimeoutStartSec=150
NoNewPrivileges=true
PrivateTmp=true
